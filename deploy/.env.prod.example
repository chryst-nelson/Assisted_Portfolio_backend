# Copy to ~/portfolio/.env on the EC2 instance (never commit the real file).
BACKEND_IMAGE=ghcr.io/<github-user-lowercase>/portfolio-backend:latest

# Lightsail managed Postgres (private endpoint if VPC-peered, else the public endpoint)
SPRING_DATASOURCE_URL=jdbc:postgresql://<lightsail-db-endpoint>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>

JWT_SECRET=<openssl rand -base64 48>
JWT_EXPIRATION_MS=86400000
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<strong password>

# Vercel production URL (comma-separate more origins if needed)
CORS_ALLOWED_ORIGINS=https://chigolite.vercel.app
KNOWLEDGE_TTL_SECONDS=120

# --- Ollama (optional; used when the rule-based engine has no answer) ---
# Separate Ollama server:  http://<ollama-server-private-ip>:11434
# Same server (with -f docker-compose.ollama.yml):  http://ollama:11434
# Empty = disabled.
OLLAMA_BASE_URL=
# qwen2.5:1.5b fits a 4 GB server; qwen2.5:3b needs ~8 GB.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_CONTEXT_TOKENS=2048
OLLAMA_MAX_TOKENS=250
# On the Ollama server only: its private IP, so the backend server can reach it.
OLLAMA_BIND=127.0.0.1
